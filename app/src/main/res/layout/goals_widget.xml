<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MY JOURNEY  ·  أهداف اليوم"
  android:textColor="#62D8D0" android:textStyle="bold" android:textSize="14sp"/>
 <TextView android:id="@+id/widget_count" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="0/0 مكتمل" android:textColor="#FFFFFF" android:textSize="12sp" android:paddingTop="5dp"/>
 <TextView android:id="@+id/widget_goals" android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:gravity="top" android:text="افتح التطبيق وأضف أهدافك اليومية"
  android:textColor="#DCEAF5" android:textSize="13sp" android:paddingTop="7dp" android:maxLines="4"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اضغط لفتح رحلتك  ↗"
  android:textColor="#8FA9BD" android:textSize="10sp" android:gravity="end"/>
</LinearLayout>
